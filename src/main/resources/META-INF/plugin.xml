<idea-plugin>
  <id>dev.hakumi.neri</id>
  <name>Neri</name>
  <version>0.4.3-dev</version>
  <vendor>Hakumi</vendor>
  <description><![CDATA[
    Syntax highlighting for Neri source files (.hk), including typed declarations,
    closures, strings, comments, and native operations. Provides line comments
    and bracket pairing through the bundled Neri grammar. Includes native Rider
    Run, Build, Check and LLDB DAP debugging through the installed Neri compiler.
    Live diagnostics use the compiler's editor-independent language server via
    neri lsp. Completion, hover, navigation and references are provided by a
    compatible Neri language server.
  ]]></description>
  <idea-version since-build="262" until-build="262.*"/>
  <depends>com.intellij.modules.lang</depends>
  <depends>org.jetbrains.plugins.textmate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.xdebugger</depends>
  <depends optional="true" config-file="neri-editorconfig.xml">org.editorconfig.editorconfigjetbrains</depends>
  <dependencies>
    <module name="intellij.platform.dap"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="dev.hakumi.neri.NeriLspIntegrationProvider"/>
    <enterHandlerDelegate implementation="dev.hakumi.neri.NeriEnterHandler"/>
    <projectConfigurable parentId="language" id="neri.toolchain" displayName="Neri"
                         instance="dev.hakumi.neri.NeriToolchainConfigurable"/>
    <configurationType implementation="dev.hakumi.neri.NeriConfigurationType"/>
    <runConfigurationProducer implementation="dev.hakumi.neri.NeriConfigurationProducer"/>
    <platform.dap.debugAdapterSupportProvider implementation="dev.hakumi.neri.NeriDebugAdapterSupportProvider"/>
    <platform.dap.launchArgumentsProvider implementation="dev.hakumi.neri.NeriDapLaunchArgumentsProvider"/>
    <xdebugger.breakpointType implementation="dev.hakumi.neri.NeriLineBreakpointType"/>
    <xdebugger.breakpointType implementation="dev.hakumi.neri.NeriExceptionBreakpointType"/>
    <fileType name="Neri" implementationClass="dev.hakumi.neri.NeriFileType"
              fieldName="INSTANCE" extensions="hk"/>
    <editorHighlighterProvider filetype="Neri"
              implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
    <textmate.bundleProvider implementation="dev.hakumi.neri.NeriBundleProvider"/>
  </extensions>
  <applicationListeners>
    <listener class="dev.hakumi.neri.NeriProjectFilesListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    <listener class="dev.hakumi.neri.NeriPluginListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
  </applicationListeners>
  <projectListeners>
    <listener class="dev.hakumi.neri.NeriEditorListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>
  <actions>
    <group id="Neri.Tools" text="Neri" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Neri.GotoDeclaration" class="dev.hakumi.neri.NeriGotoDeclarationAction"
              text="Go to Declaration" description="Navigate to the declaration reported by the Neri language server"/>
      <action id="Neri.RestartLanguageServer" class="dev.hakumi.neri.NeriRestartLanguageServerAction"
              text="Restart Language Server" description="Restart the project's Neri language server"/>
      <action id="Neri.LanguageService" class="dev.hakumi.neri.NeriLanguageServiceAction"
              text="Language Server Status" description="Show the Neri language server and source-file status"/>
      <separator/>
      <action id="Neri.ReloadHighlighting" class="dev.hakumi.neri.ReloadNeriHighlightingAction"
              text="Reload Highlighting" description="Reload the Neri grammar and refresh file recognition"/>
    </group>
  </actions>
</idea-plugin>
